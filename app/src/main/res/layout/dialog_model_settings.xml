<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="上下文大小"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#333333" />

    <Spinner
        android:id="@+id/spinnerContext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Temperature (0.0 - 2.0)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#333333" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <SeekBar
            android:id="@+id/seekTemperature"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="200"
            android:progress="100" />

        <TextView
            android:id="@+id/tvTemperature"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:text="1.0"
            android:textSize="14sp"
            android:textAlignment="textEnd" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Top-K (1 - 100)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#333333" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <SeekBar
            android:id="@+id/seekTopK"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="40" />

        <TextView
            android:id="@+id/tvTopK"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:text="40"
            android:textSize="14sp"
            android:textAlignment="textEnd" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Top-P (0.0 - 1.0)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#333333" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <SeekBar
            android:id="@+id/seekTopP"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="95" />

        <TextView
            android:id="@+id/tvTopP"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:text="0.95"
            android:textSize="14sp"
            android:textAlignment="textEnd" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="System Prompt"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#333333" />

    <EditText
        android:id="@+id/etSystemPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="80dp"
        android:gravity="top|start"
        android:hint="可选：设置系统提示词"
        android:inputType="textMultiLine"
        android:textSize="14sp" />

    <CheckBox
        android:id="@+id/cbSpeculativeDecoding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="启用推测解码（加速推理）"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="多模态支持"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#333333" />

    <CheckBox
        android:id="@+id/cbSupportImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="支持图片输入"
        android:textSize="14sp" />

    <CheckBox
        android:id="@+id/cbSupportAudio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="支持音频输入（仅 WAV 格式）"
        android:textSize="14sp" />

</LinearLayout>

</ScrollView>